<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<AnchorPane prefHeight="600.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.HomePage.AirportsPageController"
            stylesheets="@modern-airport.css"
            styleClass="root-pane">

    <children>

        <Label layoutX="20" layoutY="20"
               text="Repterek Kezelése"
               styleClass="title-label"/>

        <Button fx:id="logoutButton"
                layoutX="1040" layoutY="14"
                onAction="#onLogout"
                text="Kijelentkezés"
                styleClass="logout-button"/>

        <ComboBox fx:id="menuComboBox"
                  layoutX="25" layoutY="80" prefWidth="220"
                  styleClass="menu-combo">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Főoldal"/>
                    <String fx:value="Kapuk(Ez inkább a repterekhez menne)"/>
                    <String fx:value="Repülők"/>
                    <String fx:value="Repterek"/>
                    <String fx:value="Repülőutak"/>
                    <String fx:value="Terminál(Ez is inkább reptér)"/>
                </FXCollections>
            </items>
        </ComboBox>

        <Label layoutX="270" layoutY="84"
               text="Keresés:"
               styleClass="label-bold"/>

        <TextField fx:id="searchField"
                   layoutX="330" layoutY="80"
                   prefWidth="280"
                   promptText="Név / város / ország / ICAO"
                   styleClass="search-field"/>

        <Button layoutX="630" layoutY="80"
                text="Frissítés"
                onAction="#onRefresh"
                styleClass="refresh-button"/>

        <Label fx:id="statusLabel"
               layoutX="25" layoutY="560"
               text="Repülőterek betöltése..."
               styleClass="status-label"/>

        <TableView fx:id="airportsTable"
                   layoutX="25" layoutY="130"
                   prefHeight="410" prefWidth="1150"
                   styleClass="modern-table">
            <columns>
                <TableColumn fx:id="icaoCodeColumn" prefWidth="70" text="ICAO"/>
                <TableColumn fx:id="iataCodeColumn" prefWidth="60" text="IATA"/>
                <TableColumn fx:id="nameColumn" prefWidth="200" text="Név"/>
                <TableColumn fx:id="cityColumn" prefWidth="120" text="Város"/>
                <TableColumn fx:id="countryColumn" prefWidth="120" text="Ország"/>
                <TableColumn fx:id="timezoneColumn" prefWidth="120" text="Időzóna"/>
                <TableColumn fx:id="latitudeColumn" prefWidth="80" text="Szélesség"/>
                <TableColumn fx:id="longitudeColumn" prefWidth="80" text="Hosszúság"/>
                <TableColumn fx:id="elevationColumn" prefWidth="70" text="Magasság"/>
                <TableColumn fx:id="addressColumn" prefWidth="180" text="Cím"/>
                <TableColumn fx:id="postalCodeColumn" prefWidth="80" text="Irszám"/>
                <TableColumn fx:id="websiteUrlColumn" prefWidth="150" text="Weboldal"/>
                <TableColumn fx:id="phoneMainColumn" prefWidth="120" text="Telefon"/>
                <TableColumn fx:id="emailMainColumn" prefWidth="160" text="Email"/>
            </columns>
        </TableView>

    </children>
</AnchorPane>