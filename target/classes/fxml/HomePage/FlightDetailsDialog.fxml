<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.HomePage.FlightDetailsDialogController"
            prefWidth="700" prefHeight="500">

    <!-- Járat fejléc -->
    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>
                <Label text="Járat részletei" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                <HBox spacing="15">
                    <children>
                        <Label text="Járatszám:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="flightNumberLabel"/>

                        <Label text="Státusz:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="statusLabel"/>
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <Label text="Útvonal:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="routeLabel" />
                    </children>
                </HBox>

                <HBox spacing="15">
                    <children>
                        <Label text="Időpontok:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="timesLabel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Repülőgép TAB -->
                <Tab text="Repülőgép">
                    <content>
                        <GridPane hgap="10" vgap="6">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <children>
                                <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Lajstromjel:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acRegistrationLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Típus ICAO:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acTypeIcaoLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Légitársaság ID:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acAirlineIdLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Státusz:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acStatusLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="MSN:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acMsnLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <Label text="Max. utaskapacitás:" GridPane.rowIndex="6" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acMaxSeatLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                <Label text="Cargo kapacitás (alap):" GridPane.rowIndex="7" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acCargoBaseLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                                <Label text="Bázis reptér ID:" GridPane.rowIndex="8" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acBaseAirportIdLabel" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                                <Label text="Gyártási év:" GridPane.rowIndex="9" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acManufactureYearLabel" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                                <Label text="Megjegyzés:" GridPane.rowIndex="10" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acNoteLabel" GridPane.rowIndex="10" GridPane.columnIndex="1"
                                       wrapText="true"/>

                                <Label text="Létrehozva:" GridPane.rowIndex="11" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acCreatedAtLabel" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                                <Label text="Módosítva:" GridPane.rowIndex="12" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="acUpdatedAtLabel" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </Tab>

                <!-- Légitársaság TAB -->
                <Tab text="Légitársaság">
                    <content>
                        <GridPane hgap="10" vgap="6">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <children>
                                <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Név:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="ICAO kód:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alIcaoLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="IATA kód:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alIataLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Ország:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alCountryLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                <Label text="Alapítás éve:" GridPane.rowIndex="5" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alFoundedYearLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                                <Label text="Aktív:" GridPane.rowIndex="6" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alActiveLabel" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                <Label text="Üzleti modell:" GridPane.rowIndex="7" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alBusinessModeLabel" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                                <Label text="Bázis reptér:" GridPane.rowIndex="8" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alBaseAirportLabel" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                                <Label text="Weboldal:" GridPane.rowIndex="9" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alWebsiteLabel" GridPane.rowIndex="9" GridPane.columnIndex="1"
                                       wrapText="true"/>

                                <Label text="Telefon:" GridPane.rowIndex="10" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alPhoneLabel" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

                                <Label text="Email:" GridPane.rowIndex="11" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alEmailLabel" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                                <Label text="Központ címe:" GridPane.rowIndex="12" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alHqAddressLabel" GridPane.rowIndex="12" GridPane.columnIndex="1"
                                       wrapText="true"/>

                                <Label text="Megjegyzés:" GridPane.rowIndex="13" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alNoteLabel" GridPane.rowIndex="13" GridPane.columnIndex="1"
                                       wrapText="true"/>

                                <Label text="Létrehozva:" GridPane.rowIndex="14" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alCreatedAtLabel" GridPane.rowIndex="14" GridPane.columnIndex="1"/>

                                <Label text="Módosítva:" GridPane.rowIndex="15" GridPane.columnIndex="0"
                                       style="-fx-font-weight: bold;"/>
                                <Label fx:id="alUpdatedAtLabel" GridPane.rowIndex="15" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>