<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="root"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.AdminPageController"
            style="-fx-background-color: black;">

    <stylesheets>
        <!-- FONTOS: útvonal a resources mappához képest -->
        <URL value="@/css/admin-matrix.css"/>
    </stylesheets>

    <Label layoutX="180" layoutY="25"
           text="Admin bejelentkezve"
           style="-fx-text-fill: #00ff88;
                  -fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-effect: dropshadow(gaussian, #00ff88, 20, 0.4, 0, 0);" />

    <Button fx:id="FelhasznalokButton"
            layoutX="220" layoutY="110"
            text="Felhasználók"
            onAction="#goToUserAdminPage" />

    <Button fx:id="logoutButton"
            text="Kijelentkezés"
            onAction="#onLogout"
            layoutX="450" layoutY="15"
            style="-fx-border-color: #ff4444;
                   -fx-text-fill: #ff4444;" />

</AnchorPane>