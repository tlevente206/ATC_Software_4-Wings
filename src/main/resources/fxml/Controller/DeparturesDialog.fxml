<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.controller.DeparturesDialogController"
            prefWidth="900" prefHeight="550"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #020617);">

    <!-- FELSŐ SÁV: cím + bezárás -->
    <top>
        <HBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="14" left="18" right="18" bottom="10"/>
            </padding>
            <children>

                <!-- Bal oldali címek -->
                <VBox spacing="4">
                    <children>
                        <Label text="Induló járatok"
                               style="-fx-text-fill: #e5e7eb; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <Label fx:id="titleLabel"
                               text="LHBP – Budapest Liszt Ferenc (Budapest)"
                               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>

                        <Label fx:id="subtitleLabel"
                               text="Mai induló járatok áttekintése."
                               style="-fx-text-fill: #6b7280; -fx-font-size: 12px;"/>
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Bezárás gomb -->
                <Button text="Bezárás"
                        onAction="#onClose"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: #4b5563;
                            -fx-border-radius: 999;
                            -fx-text-fill: #e5e7eb;
                            -fx-font-size: 12px;
                            -fx-padding: 6 14 6 14;
                        ">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                    <tooltip>
                        <Tooltip text="Ablak bezárása"/>
                    </tooltip>
                </Button>

            </children>
        </HBox>
    </top>

    <!-- KÖZÉP: fő kártya + tábla -->
    <center>
        <VBox spacing="14" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="0" left="18" right="18" bottom="16"/>
            </padding>
            <children>

                <!-- Felső info kártya -->
                <HBox spacing="12">
                    <children>
                        <VBox spacing="6"
                              style="
                                  -fx-background-color: #020617;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 14;
                                  -fx-padding: 12;
                              ">
                            <children>
                                <Label text="Összes induló járat (ma)"
                                       style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>

                                <!-- 🔹 EZ A LABEL KAP ID-T -->
                                <Label fx:id="totalDeparturesLabel"
                                       text="—"
                                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                                <Label text="A tábla az adott nap induló járatait mutatja."
                                       wrapText="true"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <!-- FŐ TÁBLA KÁRTYA -->
                <VBox spacing="10"
                      VBox.vgrow="ALWAYS"
                      style="
                          -fx-background-color: #020617;
                          -fx-background-radius: 14;
                          -fx-border-color: #1f2937;
                          -fx-border-radius: 14;
                          -fx-padding: 12;
                      ">
                    <children>

                        <!-- Tábla fej -->
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <Label text="Induló járatok listája"
                                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                                <Label text="• Csak az adott napra szűrt adatok"
                                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
                            </children>
                        </HBox>

                        <!-- Tábla -->
                        <TableView fx:id="departuresTable"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent;">

                            <columns>

                                <!-- Érkezési repülőtér (destinationName) -->
                                <TableColumn fx:id="arrivalAirportCol"
                                             text="Érkezési repülőtér"
                                             prefWidth="150.0" />

                                <!-- Légitársaság -->
                                <TableColumn fx:id="airlineCol"
                                             text="Légitársaság"
                                             prefWidth="160.0" />

                                <!-- Járatszám -->
                                <TableColumn fx:id="flightNumberCol"
                                             text="Járatszám"
                                             prefWidth="120.0" />

                                <!-- Tervezett indulás -->
                                <TableColumn fx:id="scheduledDepartureCol"
                                             text="Tervezett indulás"
                                             prefWidth="150.0" />

                                <!-- Tervezett érkezés -->
                                <TableColumn fx:id="scheduledArrivalCol"
                                             text="Tervezett érkezés"
                                             prefWidth="150.0" />

                                <!-- Státusz -->
                                <TableColumn fx:id="statusCol"
                                             text="Státusz"
                                             prefWidth="120.0" />

                                <!-- Becsült indulás -->
                                <TableColumn fx:id="estimatedDepartureCol"
                                             text="Becsült indulás"
                                             prefWidth="150.0" />

                                <!-- Becsült érkezés -->
                                <TableColumn fx:id="estimatedArrivalCol"
                                             text="Becsült érkezés"
                                             prefWidth="150.0" />

                                <!-- Tényleges indulás -->
                                <TableColumn fx:id="actualDepartureCol"
                                             text="Tényleges indulás"
                                             prefWidth="150.0" />

                                <!-- Tényleges érkezés -->
                                <TableColumn fx:id="actualArrivalCol"
                                             text="Tényleges érkezés"
                                             prefWidth="150.0" />

                                <!-- Légijármű -->
                                <TableColumn fx:id="aircraftCol"
                                             text="Légijármű"
                                             prefWidth="150.0" />

                                <!-- Kapu -->
                                <TableColumn fx:id="gateCol"
                                             text="Kapu"
                                             prefWidth="130.0" />

                                <!-- Utolsó frissítés -->
                                <TableColumn fx:id="updatedAtCol"
                                             text="Utolsó frissítés"
                                             prefWidth="150.0" />

                            </columns>
                        </TableView>

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>