<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.controller.ControllerHomePageController">

    <!-- FELSŐ RÉSZ: köszönés + reptér + gombok -->
    <top>
        <VBox spacing="8" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" left="16" right="16" bottom="10"/>
            </padding>
            <children>

                <!-- Köszönés -->
                <Label fx:id="greetingLabel" text="Jó napot, Controller!"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                <!-- Reptér címsor -->
                <Label fx:id="airportTitleLabel"
                       text="Otthoni repülőtér: LHBP – Budapest Liszt Ferenc"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                <!-- Alcím -->
                <Label fx:id="subtitleLabel"
                       text="Áttekintés: időjárás, kapuk és mai járatok."/>

                <!-- Alap reptér infó -->
                <Label fx:id="airportBasicLabel"
                       text="LHBP – Budapest Liszt Ferenc (Budapest)"
                       style="-fx-text-fill: #555555;"/>

                <!-- Gombsor – JELENLEG FUNKCIÓ NÉLKÜL -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Button text="Dashboard frissítése"/>
                        <Button text="Induló járatok"/>
                        <Button text="Érkező járatok"/>
                        <Button text="Új járat"/>
                        <Button text="Időjárás asszisztens"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </top>

    <!-- KÖZÉP: 4 elkülönített szegmens -->
    <center>
        <GridPane hgap="16" vgap="16" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" left="16" right="16" bottom="16"/>
            </padding>

            <children>
                <!-- IDŐJÁRÁS BLOKK (bal oldalt, nagyobb, 2 sort foglal) -->
                <VBox fx:id="weatherCard"
                      onMouseClicked="#onOpenWeatherDetails"
                      GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.rowSpan="2"
                      spacing="8"
                      style="
                          -fx-border-color: #cccccc;
                          -fx-border-radius: 6;
                          -fx-background-color: #f5f5f5;
                          -fx-background-radius: 6;
                          -fx-padding: 10;
                          -fx-cursor: hand;
                      ">
                    <children>
                        <Label text="Időjárás"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="weatherEmojiLabel" text="⏳"
                                       style="-fx-font-size: 26px;"/>
                                <VBox spacing="4">
                                    <children>
                                        <Label fx:id="temperatureLabel" text="-- °C"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                                        <Label fx:id="conditionLabel" text="Nincs adat"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <GridPane hgap="8" vgap="4">
                            <children>
                                <Label text="Szél:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="windLabel" text="--"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <Label text="Láthatóság:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="visibilityLabel" text="--"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                <Label text="Nyomás:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="pressureLabel" text="--"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                <Label text="Hőérzet:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label fx:id="feelsLikeLabel" text="--"
                                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                <Label text="Frissítve:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <Label fx:id="updatedAtLabel" text="--"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>

                        <Label text="METAR:"
                               style="-fx-font-weight: bold; -fx-padding: 6 0 0 0;"/>
                        <Label fx:id="metarLabel"
                               text="METAR adatok itt fognak megjelenni."
                               wrapText="true"/>
                    </children>
                </VBox>

                <!-- INDULÓ JÁRATOK SZEGMENS -->
                <VBox fx:id="departuresCard"
                      onMouseClicked="#onShowDepartures"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"
                      spacing="6"
                      style="
        -fx-border-color: #cccccc;
        -fx-border-radius: 6;
        -fx-background-color: #f5f5f5;
        -fx-background-radius: 6;
        -fx-padding: 10;
        -fx-cursor: hand;
      ">
                    <children>
                        <Label text="Induló járatok (ma)"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="departuresCountLabel"
                               text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                        <Label text="Összes tervezett induló járat a mai napra."
                               wrapText="true"/>
                    </children>
                </VBox>

                <!-- ÉRKEZŐ JÁRATOK SZEGMENS -->
                <VBox fx:id="arrivalsCard"
                      GridPane.rowIndex="0" GridPane.columnIndex="2"
                      spacing="6"
                      onMouseClicked="#onShowArrivals"
                      style="
        -fx-border-color: #cccccc;
        -fx-border-radius: 6;
        -fx-background-color: #f5f5f5;
        -fx-background-radius: 6;
        -fx-padding: 10;
        -fx-cursor: hand;
      ">
                    <children>
                        <Label text="Érkező járatok (ma)"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="arrivalsCountLabel"
                               text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                        <Label text="Összes tervezett érkező járat a mai napra."
                               wrapText="true"/>
                    </children>
                </VBox>

                <!-- SZABAD KAPUK SZEGMENS -->
                <VBox GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"
                      spacing="6"
                      style="-fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-color: #f5f5f5; -fx-background-radius: 6; -fx-padding: 10;">
                    <children>
                        <Label text="Szabad kapuk"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="freeGatesLabel"
                               text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                        <Label text="Jelenleg elérhető, szabad státuszú kapuk száma."
                               wrapText="true"/>
                    </children>
                </VBox>
            </children>
        </GridPane>
    </center>

    <!-- ALSÓ SOR: státusz üzenetek -->
    <bottom>
        <BorderPane BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="6" left="12" right="12" bottom="6"/>
            </padding>
            <center>
                <Label fx:id="statusLabel"
                       text="Dashboard betöltve."
                       style="-fx-text-fill: #666666;"/>
            </center>
        </BorderPane>
    </bottom>

</BorderPane>