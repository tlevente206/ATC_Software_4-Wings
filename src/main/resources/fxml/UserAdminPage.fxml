<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.Region?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.FourWings.atcSystem.frontend.UserAdminPageController"
            prefWidth="1400.0" prefHeight="900.0"
            style="-fx-background-color: black;"
            stylesheets="@/styles/admin-matrix.css">

    <top>
        <VBox spacing="8" BorderPane.alignment="CENTER">
            <children>
                <Label text="Felhasználókezelés – Admin felület"
                       styleClass="matrix-label">
                    <font>
                        <Font size="26"/>
                    </font>
                    <padding>
                        <Insets top="10" right="10" bottom="5" left="10"/>
                    </padding>
                </Label>

                <ToolBar>
                    <items>
                        <Button fx:id="refreshButton" text="Lista frissítése" onAction="#onRefresh" styleClass="matrix-button"/>
                        <Button fx:id="addUserButton" text="Új felhasználó" onAction="#onAddNewUser" styleClass="matrix-button"/>
                        <Button fx:id="editUserButton" text="Kijelölt szerkesztése" onAction="#onEditSelectedUser" styleClass="matrix-button"/>
                        <Button fx:id="deleteUserButton" text="Kijelölt törlése" onAction="#onDeleteUser" styleClass="matrix-button"/>
                        <Separator/>
                        <Label text="Keresés:" styleClass="matrix-label"/>
                        <TextField fx:id="searchField" promptText="Név / felhasználónév / e-mail" prefWidth="250" styleClass="matrix-textfield"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="backToAdminButton" text="Vissza az admin főoldalra" onAction="#onBackToAdmin" styleClass="matrix-button"/>
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="usersTable" BorderPane.alignment="CENTER" styleClass="matrix-table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                <TableColumn fx:id="nameColumn" text="Név" prefWidth="230"/>
                <TableColumn fx:id="usernameColumn" text="Felhasználónév" prefWidth="200"/>
                <TableColumn fx:id="emailColumn" text="E-mail" prefWidth="300"/>
                <TableColumn fx:id="phoneColumn" text="Telefon" prefWidth="180"/>
                <TableColumn fx:id="roleColumn" text="Szerepkör" prefWidth="120"/>
                <TableColumn fx:id="airportColumn" text="Irányító reptere" prefWidth="260"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label fx:id="statusLabel" text="Készen áll." styleClass="matrix-label"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
